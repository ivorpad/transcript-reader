{
  "name": "transcript-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "bun tools/audit-corpus.ts",
    "typecheck": "tsc --noEmit && tsc -p tools --noEmit",
    "fixtures": "bun tools/build-fixtures.ts",
    "sample": "bun tools/build-sample.ts --out docs/sample"
  },
  "dependencies": {
    "dompurify": "^3.4.1",
    "lit": "^3.3.2",
    "lucide": "^1.8.0",
    "marked": "^18.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
